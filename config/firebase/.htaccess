# ============================================================
# BLOQUEIO DE ACESSO HTTP DIRETO
# Este diretório contém credenciais sensíveis do Firebase.
# Nunca deve ser acessível via HTTP — apenas via PHP no servidor.
# ============================================================
Order Deny,Allow
Deny from all

# Compatibilidade com Apache 2.4+.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
Options -Indexes
