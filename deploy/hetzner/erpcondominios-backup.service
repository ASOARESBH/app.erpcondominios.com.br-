[Unit]
Description=Backup lógico local do ERP Condomínios HML
After=mysql.service
OnFailure=erpcondominios-alert-onfailure@backup_job_failure.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/erpcondominios-backup.sh
TimeoutStartSec=30min
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/backups/erpcondominios/daily /run/lock
