[Unit]
Description=Healthcheck local do ERP Condomínios HML
After=nginx.service php8.3-fpm.service mysql.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/erpcondominios-healthcheck.sh
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
