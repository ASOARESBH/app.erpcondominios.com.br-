/var/log/mysql/error.log /var/lib/mysql/*-slow.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    create 0600 mysql mysql
    sharedscripts
    postrotate
        if /usr/bin/mysqladmin --protocol=socket --user=root ping >/dev/null 2>&1; then
            /usr/bin/mysqladmin --protocol=socket --user=root flush-logs >/dev/null 2>&1
        fi
    endscript
}
